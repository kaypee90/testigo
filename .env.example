# Testigo configuration for docker compose. Copy to .env; every value below has a safe default
# for the Phase 0 demo (synthetic data only). Never commit .env.

# --- Database ---
POSTGRES_DB=testigo
POSTGRES_USER=testigo
# Change outside a local demo.
POSTGRES_PASSWORD=testigo_dev_password

# --- Host ports (bound to 127.0.0.1) ---
TESTIGO_API_PORT=5180
TESTIGO_STAFF_PORT=3101
TESTIGO_REPORTER_PORT=3102
# Where browsers reach the API and the staff dashboard (local demo).
API_BASE_URL=http://localhost:5180
STAFF_BASE_URL=http://localhost:3101

# --- Language model (docs/llm-settings.md) ---
# Mock is the local, deterministic default. All supported providers remain configurable.
# Cloud providers receive text after rule-based redaction, which can miss identifiers.
# Phase 0 is synthetic-only. See docs/llm-settings.md and docs/data-protection.md.
# Opt in to enforcement: Mock or local endpoints/models (including compatible APIs); invalid settings stop startup.
TESTIGO_LOCAL_MODELS_ONLY=false
LLM_PROVIDER=Mock
LLM_MODEL=mock
LLM_API_KEY=
# Ollama: blank = the Docker host (http://host.docker.internal:11434); http://ollama:11434 with
# COMPOSE_PROFILES=ollama.
LLM_BASE_URL=
LLM_CONTEXT_LENGTH=16384
# COMPOSE_PROFILES=ollama

# --- Key for staff two-factor secrets: openssl rand -base64 32. Blank: generated into the api-keys volume. ---
SECRETS_MASTER_KEY=

# --- Staff accounts (docs/platform.md) ---
# The built-in local sign-in for the demo. In production set both, with a long password, or
# leave LOCAL_ADMIN_USERNAME empty to turn it off.
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=admin
PLATFORM_ADMIN_EMAIL=
SETUP_TOKEN=
AUTH_EMAIL_VERIFICATION=auto

# --- Outgoing mail for staff invitations. Empty host: invitation links are shown to copy. ---
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_TLS=starttls
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=

# --- Production overlay (docker-compose.prod.yml) ---
STAFF_DOMAIN=
API_DOMAIN=
REPORTER_DOMAIN=
